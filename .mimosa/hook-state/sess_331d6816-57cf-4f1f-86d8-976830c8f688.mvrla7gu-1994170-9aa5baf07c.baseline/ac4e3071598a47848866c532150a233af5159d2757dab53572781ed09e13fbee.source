[package]
name = "dsx-core"
version = "0.1.0"
edition = "2024"
license = "MIT"
description = "DeepSeek-V4.1-Flash(-1017): config, GGUF / safetensors readers, block formats, CPU reference, OpenAI / Anthropic server"
publish = false

[dependencies]
memmap2 = "0.9"
half = "2"
anyhow = "1"
rayon = "1"
serde_json = "1"
deepseek-recipe = "0.1"
deepseek-recipe-core = "0.1"
deepseek-recipe-encoding = "0.1"
tokenizers = "0.23"
axum = "0.8"
tokio = { version = "1", features = ["macros", "rt-multi-thread", "net", "sync", "time"] }
tokio-stream = { version = "0.1", features = ["time"] }
serde = { version = "1", features = ["derive"] }
tracing = "0.1"
rust-embed = { version = "8", features = ["mime-guess"] }
image = { version = "0.25", default-features = false, features = ["png", "jpeg", "gif", "webp"] }
base64 = "0.22"

[dev-dependencies]
flate2 = "1"
reqwest = { version = "0.12", default-features = false, features = ["json", "stream"] }
